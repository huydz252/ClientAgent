<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" alignment="CENTER" prefWidth="400" prefHeight="300"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.ui.StudentLoginController">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="HỆ THỐNG THI TRỰC TUYẾN" textFill="#2c3e50">
        <font><Font name="System Bold" size="18.0"/></font>
    </Label>
    
    <Label text="Đăng nhập Học sinh" textFill="#7f8c8d"/>

    <VBox spacing="5" alignment="CENTER" maxWidth="300">
        <Label text="Mã Sinh Viên:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="codeField" promptText="Ví dụ: 23IT109"/>
    </VBox>
    
    <VBox spacing="5" alignment="CENTER" maxWidth="300">
        <Label text="Họ và Tên:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="nameField" promptText="Ví dụ: Nguyễn Văn A"/>
    </VBox>
    
    <Label fx:id="statusLabel" textFill="RED" wrapText="true" text="Lưu ý nhập Mã Sinh Viên đúng định dạng (vd: 23IT109)"/>
    
    <Button fx:id="loginButton" text="VÀO PHÒNG THI" 
            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;"
            onAction="#handleLogin"/>

</VBox>